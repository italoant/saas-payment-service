# Aplicação
PORT=3000
NODE_ENV=development

# Banco de dados (defina quando escolher o banco)
# DB_TYPE aceita: postgres | mysql | mariadb | sqlite | mssql
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=saas_payments
DB_SCHEMA=public

# SSL: ative (true) para bancos gerenciados (Neon, Supabase, Vercel Postgres, RDS)
DB_SSL=false

# Sincroniza schema automaticamente (apenas dev; em prod use migrations)
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Moeda padrão da wallet (ISO 4217)
WALLET_DEFAULT_CURRENCY=BRL

# Proteção da documentação Swagger (/doc) via HTTP Basic Auth.
# Troque em produção. Padrão: admin / changeme
SWAGGER_USER=admin
SWAGGER_PASSWORD=changeme

# =====================================================================
# Supabase (Postgres) — como conectar
# ---------------------------------------------------------------------
# O Supabase expõe DOIS endpoints para o MESMO banco. Use cada um no lugar
# certo (pegue os valores em: Supabase > Project > Connect):
#
#  1) RUNTIME (app na Vercel / serverless): Transaction pooler — porta 6543.
#     Serverless abre uma conexão nova por invocação e o Postgres tem limite;
#     o pooler multiplexa. Também é IPv4 (a conexão direta é IPv6 e a Vercel
#     costuma não resolver). Configure as DB_* de PRODUÇÃO com o pooler:
#
#       DB_TYPE=postgres
#       DB_HOST=aws-0-<região>.pooler.supabase.com
#       DB_PORT=6543
#       DB_USERNAME=postgres.<project-ref>
#       DB_PASSWORD=<sua-senha-do-banco>
#       DB_DATABASE=postgres
#       DB_SCHEMA=public
#       DB_SSL=true
#       DB_SYNCHRONIZE=false   # produção: schema só via migration
#
#  2) MIGRATIONS (rodar localmente / CI, uma vez por deploy de schema):
#     conexão DIRETA / Session pooler — porta 5432. Migrations precisam de
#     sessão persistente (locks/prepared statements), o que o transaction
#     pooler NÃO garante. Coloque esses valores no arquivo .env.migrations
#     (veja .env.migrations.example) — NÃO no runtime.
# =====================================================================

# --- Deploy na Vercel (produção, com Supabase) ---
# SQLite NÃO funciona na Vercel (filesystem efêmero). Use o Supabase (Postgres).
# Configure estas variáveis no dashboard da Vercel
# (Project > Settings > Environment Variables) usando o TRANSACTION POOLER:
#   NODE_ENV=production
#   DB_TYPE=postgres
#   DB_HOST=aws-0-<região>.pooler.supabase.com
#   DB_PORT=6543
#   DB_USERNAME=postgres.<project-ref>
#   DB_PASSWORD=<sua-senha-do-banco>
#   DB_DATABASE=postgres
#   DB_SCHEMA=public
#   DB_SSL=true
#   DB_SYNCHRONIZE=false   # rode migrations à parte (ver .env.migrations.example)
#   WALLET_DEFAULT_CURRENCY=BRL
