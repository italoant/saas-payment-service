# Aplicação
PORT=3000
NODE_ENV=development

# Banco de dados (defina quando escolher o banco)
# DB_TYPE aceita: postgres | mysql | mariadb | sqlite | mssql
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=saas_payments
DB_SCHEMA=public

# SSL: ative (true) para bancos gerenciados (Neon, Supabase, Vercel Postgres, RDS)
DB_SSL=false

# Sincroniza schema automaticamente (apenas dev; em prod use migrations)
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Moeda padrão da wallet (ISO 4217)
WALLET_DEFAULT_CURRENCY=BRL

# Proteção da documentação Swagger (/doc) via HTTP Basic Auth.
# Troque em produção. Padrão: admin / changeme
SWAGGER_USER=admin
SWAGGER_PASSWORD=changeme

# --- Deploy na Vercel (produção) ---
# SQLite NÃO funciona na Vercel (filesystem efêmero). Use Postgres gerenciado.
# Configure estas variáveis no dashboard da Vercel (Project > Settings > Environment Variables):
#   NODE_ENV=production
#   DB_TYPE=postgres
#   DB_HOST=<host-do-postgres>
#   DB_PORT=5432
#   DB_USERNAME=<user>
#   DB_PASSWORD=<password>
#   DB_DATABASE=<database>
#   DB_SSL=true
#   DB_SYNCHRONIZE=false   # rode migrations manualmente em produção
#   WALLET_DEFAULT_CURRENCY=BRL
