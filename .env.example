# Aplicacao
PORT=3000

# Banco de dados (Postgres por padrao).
# Para desenvolvimento rapido sem Postgres, rode com o profile `h2`:
#   SPRING_PROFILES_ACTIVE=h2 java -jar target/saas-payment-service-0.1.0.jar
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=saas_payments

# Moeda padrao da wallet (ISO 4217)
WALLET_DEFAULT_CURRENCY=BRL

# Protecao da documentacao Swagger (/doc, /doc-json) via HTTP Basic Auth.
# Troque em producao. Padrao: admin / changeme
SWAGGER_USER=admin
SWAGGER_PASSWORD=changeme

# =====================================================================
# Supabase (Postgres) — observacoes
# ---------------------------------------------------------------------
# Spring Boot NAO le este arquivo automaticamente: exporte as variaveis no
# shell/plataforma (ou use direnv/dotenv-cli). Em producao serverless/pooled,
# use o Transaction Pooler do Supabase (porta 6543) para o runtime e a conexao
# DIRETA / Session pooler (porta 5432) para rodar as migrations do Flyway.
#
# Exemplo de runtime (pooler):
#   DB_HOST=aws-0-<regiao>.pooler.supabase.com
#   DB_PORT=6543
#   DB_USERNAME=postgres.<project-ref>
#   DB_PASSWORD=<sua-senha>
#   DB_DATABASE=postgres
# Para SSL em bancos gerenciados, acrescente ?sslmode=require na URL do datasource
# (spring.datasource.url) ou configure via SPRING_DATASOURCE_URL.
# =====================================================================
