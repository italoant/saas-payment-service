# =====================================================================
# .env.migrations — usado APENAS pelo CLI de migration do TypeORM
# (npm run migration:run / migration:generate / migration:revert).
#
# Copie este arquivo para `.env.migrations` e preencha com os dados da
# conexão DIRETA do Supabase (Session pooler / porta 5432). NÃO use o
# transaction pooler (6543) aqui: migrations exigem sessão persistente.
#
# Onde pegar: Supabase > Project > Connect > "Session pooler" (ou
# "Direct connection"). O `.env.migrations` é ignorado pelo git.
# =====================================================================

DB_TYPE=postgres

# Session pooler do Supabase (porta 5432). Ex.:
#   DB_HOST=aws-0-<região>.pooler.supabase.com
DB_HOST=

DB_PORT=5432

# Usuário do session pooler: postgres.<project-ref>
DB_USERNAME=

# Senha do banco (definida ao criar o projeto no Supabase).
DB_PASSWORD=

DB_DATABASE=postgres
DB_SCHEMA=public

# Supabase exige SSL.
DB_SSL=true

# Nunca ligue synchronize ao rodar migrations.
DB_SYNCHRONIZE=false

# Ligue para ver o SQL executado pelas migrations.
DB_LOGGING=true
